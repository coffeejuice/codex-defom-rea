#include <winver.h>
#include "def_pre_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DEF_PRE_FILE_VERSION
 PRODUCTVERSION DEF_PRE_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Reconstructed DEF_PRE_64\0"
            VALUE "FileVersion", DEF_PRE_VERSION "\0"
            VALUE "ProductName", "Reconstructed DEF_PRE_64\0"
            VALUE "ProductVersion", DEF_PRE_VERSION "\0"
            VALUE "OriginalFilename", "DEF_PRE_64.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
