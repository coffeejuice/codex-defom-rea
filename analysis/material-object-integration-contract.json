{
  "schema_version": 1,
  "status": "static_selected_default_material_object_integration_ready_for_candidate_and_runtime_validation",
  "target_sha256": "f78a2a5c3ebb3c1affca3d2d0ea31f0ed802f6fe1e9083168681502ac6cea794",
  "scope": "Current owned ObjectModel objects and immutable default-name-only materials, with reset/selected simulation controls. This removes the two artificial cross-domain exclusions; it does not reconstruct general material properties, reference graphs, borrowed storage or allocation-failure behavior.",
  "implementation_recommendation": [
    "Remove the any-object rejection from find_or_create_material and the any-material rejection from find_or_create(object). Keep the asserted selected simulation profile and immutable material defaults.",
    "For a missing material ID retain native ordering: scan selector; allocate/append default record; assign ID; update material count; regenerate root layout; refresh every active object; release scratch mappings; read material name. Name failure preserves creation and refresh. Existing-ID rename does not refresh.",
    "Reuse ObjectModel::refresh_components: assign refreshed root table BEFORE iterating objects; skip type7; invoke MeshStorage::refresh_components using allocation counts/arity and existing StateVariable allocation semantics. Do not replace/reset geometry, names, STROKE, IDs, object identity, boundaries or default-fill mesh arrays.",
    "Do not implement material-column permutation for this immutable default-name-only profile: feature49 is false and native1d0fc0 does not execute that branch. Do not generalize this rule to MSTMTR/mode1 materials.",
    "New objects after materials use the existing constructor and placeholder ordering. Material presence alone does not change represented constructor defaults or selected geometry finalization. Keep the original positive object-ID rule, distinct from material IDs."
  ],
  "native_sequence": {
    "entry": "MTNAME384a50 missing exactID:29ca10(list,0) snapshots old IDs/ranks;29c060 appends;recordID assigned;root1320=199c50;1d0fc0(root,1);29ca10(list,1);413ab0 name.",
    "temporary_copy": "1d0fc0 copies79 old component integers; creates temporary object list owned by same root. If both scratch pointers are nonnull, each active source(type!=7) is copied to a new temporary object before1d0320. Scratch calloc(0) nullness is CRT-dependent, so do not assume first-material copies never happen.",
    "copy_signature": {
      "procedure": "0x1401613a0",
      "parameters": [
        "destination object",
        "source object",
        "old component table int[79]",
        "flag4 byte*",
        "flag5 byte*",
        "flag6 byte*",
        "flag7 byte*",
        "flag8 byte*",
        "flag9 byte*"
      ],
      "flag_values": [
        1,
        1,
        1,
        1,
        0,
        1
      ],
      "flags": "flag8 controls initial ID copy and is0; caller writes destID immediately afterward. flag7 copies name; flag5 node copy inclusion of17; flags4/6/9 element exclusions. All inclusion flags here are1."
    },
    "refresh": "1d0320 refreshes root table. Every nonnull active live object receives199650(object,newtable,oldtable); its actual signature uses only first2 arguments.199650 gets node allocation count via182840 and element allocation count/arity via1854f0/185530, then180150/183770.",
    "remap": "Only after refresh, and only when maps nonnull, temporary object found by exactID, and1d64f0(root,49,null) true: zero both live double arrays object+a58/a60 for header elementcount * new root16bc, then copy columns by old rank\u00e2\u2020\u2019new rank using29c870/29c7f0. This branch is unreachable with immutable mode1cc8=0 material records and reset root85c.",
    "cleanup": "17ab70 deletes temporary list objects through19a290\u00e2\u2020\u201915f790\u00e2\u2020\u201915fbf0; temporary list metadata cleared. Scratch mappings later freed by29ca10(mode1). Native allocation identities and failure paths are not reproduced."
  },
  "copy_effects": [
    {
      "path": "1618b0\u00e2\u2020\u2019virtual+20 at _OBJ_GEO3D vtable548d18 =2f9dc0\u00e2\u2020\u20192f9b60",
      "effect": "Clears destination spatial slots, copies flag3990 and slot selector, then copies all100 geometry slots. Destination coordinate/connectivity/classification buffers and plane lists are distinct. Source coordinate/connectivity accessors26a3c0/2fe9d0/2fe9f0 end in pure buffer pointer getters26a4d0/2ff1a0."
    },
    {
      "path": "1619c0\u00e2\u2020\u20193019d0\u00e2\u2020\u2019280490\u00e2\u2020\u2019276140",
      "effect": "Clears and recreates destination alternate container list; copies segment payloads, matrix and flag.2D dispatch invokes1619c0 and1613a0 invokes it again later. These are destination copies, not a transfer. Raw native source list accessor can COW-detach when shared; see storage qualifications."
    },
    {
      "path": "180390\u00e2\u2020\u2019180150 and183900\u00e2\u2020\u2019183770\u00e2\u2020\u2019329ef0\u00e2\u2020\u2019virtual+18=301770",
      "effect": "Allocates destination node/element direct arrays using source header counts and old root component table, then copies registered descriptor values and direct arrays. StateVar virtual+18 calls destination allocation via virtual+8=301710, copies source dimensions and values. No live source metadata assignment in these functions. Temporary descriptor allocation history need not equal source history."
    },
    {
      "path": "17ec20,185a10",
      "effect": "Allocate destination boundary groups/property buffers and memcpy from source.165170 may recompute temporary object's boundary total after copied groups; it does not receive the live source."
    },
    {
      "path": "186590,18bd30\u00e2\u2020\u201918beb0,189b70,195c80,161ac0",
      "effect": "Copy destination scalar/property/table fields, including STROKE. Table copier12eff0 allocates destination axes/dependent storage and reads source. Nested list/property families are empty/default in the selected modeled profile; arbitrary nondefault scientific families remain outside this reduction."
    },
    {
      "path": "15f790\u00e2\u2020\u201915fbf0 and197ec0",
      "effect": "Destroy destination-owned mesh, geometry, nested fields and alternate list.162070/199b10/199b60 free destination auxiliary fields. No material-list mutation is present in the selected copy/cleanup chain."
    }
  ],
  "storage_qualifications": [
    "301050(source descriptor)\u00e2\u2020\u20191d9050(source+28)\u00e2\u2020\u20190051a0 can decrement a shared backing refcount and replace the source backing with a deep clone when refcount>1. Fresh independent descriptor storage in the selected API is unshared; semantic values are preserved even when native sharing causes pointer changes.",
    "301b40(source alternate list)\u00e2\u2020\u2019301f50\u00e2\u2020\u2019302090 similarly detaches only when backing refcount>1. The reconstructed GeometrySegments has owned value storage and no aliasing API.",
    "Native direct arrays use realloc on refresh even with unchanged extents. Pointer movement is not evidence of a value change, and preservation of pointer identity is not promised.",
    "Do not assert unknown grown direct tails equal zero. Preserve initialized-prefix metadata already implemented in MeshStorage. Temporary copies can read those native bytes but do not feed them back while remap is disabled.",
    "Current selected source structures have valid count/buffer relationships. Corrupt counts, partially constructed allocation failure, external shared aliases and unsupported scientific subobjects require additional evidence rather than silent generalization."
  ],
  "inverse_creation": {
    "chain": "17a880\u00e2\u2020\u201915ec80\u00e2\u2020\u201915ef60\u00e2\u2020\u201915f0b0",
    "findings": [
      "15f0b0 initializes represented ID/type/counts/mesh flags/STROKE/default geometry independently of root material count/list. Node17f060 and element1829c0 reset allocation counts and register descriptors without material lookup.",
      "15f9a0(object,0) resolves owner units via1c8f40 and sets object1eb8/1ec0 defaults; it does not consult material records.",
      "186200 initializes property scalars/tables and dimension-dependent values;189790/195980 initialize empty owned lists; the examined defaults depend on owner dimension/units, not material presence.",
      "2059a0 finalizes object geometry only;1d6250 scans material references but does nothing for all default mode1cc8=0 records. These defaults do not justify skipping the existing normal geometry finalizer.",
      "Nonempty default materials continue to have feature49/53/29/54/55 off and query46 dimensional default; root count is supplied to the layout recipe but gated widths remain zero. Root output flags and other already modeled controls retain their effects."
    ]
  },
  "runtime_plan": [
    "Create populated active mesh before first/second missing materials; compare all selected state before/after1d0fc0 and1613a0, root table ordering, descriptors, known direct prefixes, names and stable object identities.",
    "Include inactive(type7) objects and verify no refresh/copy of their containers; add materials after deactivation, then reactivate/create mesh.",
    "Create materials before objects, including placeholder-producing IDs; verify constructor defaults, mesh allocation/replacement and geometry finalization.",
    "Include both dimensions, same-dimension header preservation and changed-dimension destruction of both lists.",
    "Include direct3D geometry and alternate containers/nonidentity matrix alongside mesh; compare source values across temporary copy and cleanup.",
    "Rename existing materials among objects and fail a new material name read; verify rename skips refresh and failed name retains append/refresh.",
    "Capture scratch-map nullness, source StateVar/list refcounts if safely readable, temp descriptor registration and bounded allocation extents. Do not read temporary geometry arrays without independent extent proof."
  ],
  "evidence_limitations": [
