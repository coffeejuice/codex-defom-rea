    },
    {
      "file_offset": "0x50b230",
      "text": "Variable"
    },
    {
      "file_offset": "0x50b240",
      "text": "\t        DEF_PRE.EXE -m simStepList -d a.db -o simStepList.txt\n"
    },
    {
      "file_offset": "0x50b280",
      "text": "\t  o. Get the simulation step number list\n"
    },
    {
      "file_offset": "0x50b2b0",
      "text": "\t        DEF_PRE.EXE -m lastStepNo -d a.db -o lastStepNo.txt\n"
    },
    {
      "file_offset": "0x50b2f0",
      "text": "\t  o. Get the last step number\n"
    },
    {
      "file_offset": "0x50b310",
      "text": "\t        DEF_PRE.EXE -m stepList -d a.db -o stepList.txt\n"
    },
    {
      "file_offset": "0x50b350",
      "text": "\t  o. Get step number list\n"
    },
    {
      "file_offset": "0x50b370",
      "text": "\t        DEF_PRE.EXE -m header -d a.db -o header.txt\n"
    },
    {
      "file_offset": "0x50b3a8",
      "text": "\t  o. Get header information\n"
    },
    {
      "file_offset": "0x50b3c8",
      "text": "\t        DEF_PRE.EXE -h\n"
    },
    {
      "file_offset": "0x50b3e8",
      "text": "\t  o. This help screen\n"
    },
    {
      "file_offset": "0x50b400",
      "text": "\tExample\n"
    },
    {
      "file_offset": "0x50b410",
      "text": "\t                    [-o <file name>]\n"
    },
    {
      "file_offset": "0x50b438",
      "text": "\t                    [-d <db name>]\n"
    },
    {
      "file_offset": "0x50b460",
      "text": "\t                    [-m {header|stepList|lastStepNo|simStepList}]\n"
    },
    {
      "file_offset": "0x50b4a8",
      "text": "\t        DEF_PRE.EXE [-h]\n"
    },
    {
      "file_offset": "0x50b4c8",
      "text": "\t  o. Batch mode\n"
    },
    {
      "file_offset": "0x50b4e0",
      "text": "\t        - OR -  \n"
    },
    {
      "file_offset": "0x50b4f8",
